# Скопировать в .env.local (Mac) и заполнить. Секреты в git не попадают.

# OpenRouter: ключ для ИИ-генерации (секрет)
OPENROUTER_API_KEY=

# Анализатор морфем: локально mecab-ko-fastapi на Mac, на проде адрес контейнера Fly.io
ANALYZER_URL=http://127.0.0.1:8000
# Подпись запросов к анализатору (секрет)
ANALYZER_SECRET=

# Модели по умолчанию, при необходимости переопределить здесь
MODEL_WRITE=anthropic/claude-sonnet-5.5
MODEL_LIGHT=anthropic/claude-haiku-5.5
MODEL_VISION=google/gemini-3.8-flash
MODEL_VERIFY=google/gemini-3.8-flash
MODEL_EMBED=baai/bge-m3

# Postgres (Supabase, пулер Supavisor, порт 6543) (секрет)
DATABASE_URL=

# Часовой пояс для «дня» (на Vercel задавать всегда явно)
APP_TZ=Asia/Jayapura

# Дата экзамена TOPIK II в формате YYYY-MM-DD, необязательна
EXAM_DATE=

# Вход владельца: хеш пароля и секрет подписи сессии (секреты)
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# Лента для зрителей: on или off (любое значение, кроме on/true/1/yes, закрывает ленту)
PUBLIC_FEED=on

# Словарь 한국어기초사전: ключ API (секрет), понадобится в Task 7
KRDICT_API_KEY=

# Папка с книгами на Mac для скриптов базы знаний (в облако не отправляется)
KB_SOURCE_DIR=
