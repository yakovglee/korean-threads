# Supabase. Локально значения печатает `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ (service role) — только на сервере.
SUPABASE_SECRET_KEY=

# OpenRouter: ответы бота и эмбеддинги одним ключом (ADR 0002).
OPENROUTER_API_KEY=
# Необязательно: OpenRouter-совместимый прокси.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель эмбеддингов: победитель `npm run eval:embeddings` (baai/bge-m3 или qwen/qwen3-embedding-8b).
EMBEDDING_MODEL=baai/bge-m3

# 한국어기초사전 Open API (krdict.korean.go.kr → openApiRegister).
KRDICT_API_KEY=

# Сервис mecab-ko-fastapi админа (ADR 0006), например https://mecab.example.com
MECAB_URL=

# Куда ведёт ссылка из письма; на Vercel — адрес приложения.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
